{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "azatisrail",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-04-29",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Иначе статику (index.html и т.п.) Cloudflare отдаёт в обход Worker'а, и переадресация
    // со старого azatisrail.cc на fundan.cc (LEGACY_HOSTS в index.js) не срабатывает.
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Реальные id создаются владельцем один раз командой:
  //   npx wrangler kv namespace create FUNDING_KV
  //   npx wrangler kv namespace create TOKENS_KV
  // и id из вывода команды вписываются сюда вместо REPLACE_ME.
  // Подробности — DEPLOY.md.
  // Workers AI — эмбеддинги для семантического поиска по базе доноров (worker/src/semantic.js).
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    { "binding": "FUNDING_KV", "id": "6f4f8b9a4ff941f0af07c6abe484f949" },
    { "binding": "TOKENS_KV", "id": "f26fc1fd267b471290f0c5fbed2f6a65" }
  ],
  // Оставляем *.workers.dev как запасной адрес для проверки/отладки.
  "workers_dev": true,
  // fundan.cc — основной домен (куплен в Cloudflare Registrar, своих DNS-записей нет), поэтому
  // Custom Domain: Cloudflare сам заводит DNS и сертификат.
  // azatisrail.cc — старый домен: Route (не Custom Domain!), т.к. он проксируется с внешним DNS
  // (CNAME на GitHub Pages), и Custom Domain конфликтовал бы с существующей записью. Worker
  // переадресует его страницы на fundan.cc (см. LEGACY_HOSTS в worker/src/index.js).
  "routes": [
    { "pattern": "fundan.cc", "custom_domain": true },
    { "pattern": "www.fundan.cc", "custom_domain": true },
    { "pattern": "azatisrail.cc/*", "zone_name": "azatisrail.cc" }
  ]
}
