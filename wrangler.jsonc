{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "azatisrail",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-04-29",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Реальные id создаются владельцем один раз командой:
  //   npx wrangler kv namespace create FUNDING_KV
  //   npx wrangler kv namespace create TOKENS_KV
  // и id из вывода команды вписываются сюда вместо REPLACE_ME.
  // Подробности — DEPLOY.md.
  "kv_namespaces": [
    { "binding": "FUNDING_KV", "id": "6f4f8b9a4ff941f0af07c6abe484f949" },
    { "binding": "TOKENS_KV", "id": "f26fc1fd267b471290f0c5fbed2f6a65" }
  ],
  // Подключает сам домен к этому Worker'у (вместо GitHub Pages) — работает только если
  // зона azatisrail.cc находится в том же Cloudflare-аккаунте, под которым сделан "wrangler login".
  "routes": [
    { "pattern": "azatisrail.cc", "custom_domain": true }
  ]
}
